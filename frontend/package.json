    "test": "vitest run",
    "format": "prettier --write src"
  },
  "dependencies": {
    "react": "^19.1.0", "react-dom": "^19.1.0", "react-router-dom": "^7.6.0",
    "lightweight-charts": "^5.0.0", "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0", "eslint": "^9.28.0", "typescript-eslint": "^8.33.0",
    "@types/react": "^19.1.0", "@types/react-dom": "^19.1.0", "@types/node": "^24.0.0",
    "@vitejs/plugin-react": "^4.5.0", "vite": "^6.3.0", "typescript": "^5.8.0",
    "tailwindcss": "^4.1.0", "@tailwindcss/vite": "^4.1.0",
    "vitest": "^3.2.0", "jsdom": "^26.1.0", "@testing-library/react": "^16.3.0",
    "@testing-library/jest-dom": "^6.6.0", "@testing-library/user-event": "^14.6.0", "prettier": "^3.5.0"
  }
