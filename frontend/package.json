{
  "name": "stockeasy-frontend",
  "private": true,
  "version": "0.1.0-dev",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit",
