# Copy to .env in the repository root. No defaults contain credentials.
# Local development uses SQLite. Production uses Neon/Postgres through Vercel's
# encrypted DATABASE_URL environment variable.
DATABASE_URL=sqlite:///../data/stockeasy.db
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080
COOKIE_SECURE=false
SESSION_HOURS=12
ALPHA_VANTAGE_API_KEY=
FMP_API_KEY=
EODHD_API_KEY=
TWELVE_DATA_API_KEY=
COINGECKO_API_KEY=
# Required before SEC requests: StockEasy Your Name your@email.example
SEC_USER_AGENT=
QUOTE_TTL=900
HISTORY_TTL=86400
FUNDAMENTAL_TTL=86400
PROFILE_TTL=604800
FX_TTL=86400
